      "description": "The run object: printed by run, resume, wait and show (--json) and listed by list. Text inside the stored artifact is untrusted; the marked fields are the ones in this object."
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "maxLength": 512,
          "description": "Closed codes, ids and counts only; never untrusted text."
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/error_reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required with code refused (a refusal reason); also tool_missing, no_tmux, schema_newer and wait_timeout (code failed) and previous_mismatch (code usage)."
        },
        "details": {
          "type": [
            "object",
            "null"
          ],
          "description": "Closed codes, ids and counts only (for example the tool name and its install command, the matching run ids of an ambiguous prefix)."
        },
        "lower_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "A sibling tool's closed error code; never its message."
        },
        "hook": {
          "enum": [
            "pre-run",
            null
          ],
          "description": "The hook that vetoed or escalated (code vetoed or escalated); null otherwise."
        },
        "decision_ids": {
          "$ref": "#/$defs/decision_ids",
          "description": "Decision ids a pre-run hook printed; present with hook."
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "refused"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "$ref": "#/$defs/refusal_reason"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "vetoed",
                  "escalated"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "hook"
            ],
            "properties": {
              "hook": {
                "const": "pre-run"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "tool_missing",
                  "no_tmux",
                  "wait_timeout",
                  "schema_newer",
                  null
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "usage"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "previous_mismatch",
                  null
                ]
              }
            }
          }
        }
      ]
