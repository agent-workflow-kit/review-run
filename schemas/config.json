{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-run/config.json",
  "title": "review-run config",
  "description": "~/.config/review-run/config.yaml (XDG-aware) plus config.d/*.yaml drop-ins. Precedence: flags, repos.<id>, environment (REVIEW_RUN_<KEY>, top-level scalars only), global config, defaults. run_pr_code exists only under repos.<id>. Invalid config fails fast naming the key. Durations cannot be range-checked here.",
  "type": "object",
  "properties": {
    "skill": {
      "$ref": "#/$defs/skill",
      "default": "review-run:review-pr",
      "description": "The skill; bundled default or any other."
    },
    "permission_profile": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^/",
      "default": null,
      "description": "Permission profile file passed on every call; null: the bundled file."
    },
    "sandbox": {
      "enum": [
        "required",
        "preferred",
        "off"
      ],
      "default": "required",
      "description": "Session sandbox level passed on every call."
    },
    "setting_sources": {
      "type": "array",
      "items": {
        "enum": [
          "user",
          "project",
          "local"
        ]
      },
      "uniqueItems": true,
      "default": [],
      "description": "Setting sources passed on every call."
    },
    "env_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true,
      "default": [
        "PATH"
      ],
      "description": "Names passed with --env-allowlist-only."
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "default": null,
      "description": "--model; null: Claude Code's default."
    },
    "timeout": {
      "oneOf": [
        {
          "$ref": "#/$defs/duration"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "--timeout; null: the kind's default (120 minutes)."
    },
    "subagents": {
      "type": "boolean",
      "default": false,
      "description": "true drops the Agent and Task denies from the profile."
    },
    "max_subagent_depth": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Depth variable when subagents is on."
    },
    "nits": {
      "type": "boolean",
      "default": false,
      "description": "Ask the skill for nit-severity findings."
    },
    "guidelines_file": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "default": null,
      "description": "A user-owned file placed in the prompt as trusted instructions."
    },
    "mode": {
      "$ref": "#/$defs/mode",
      "default": "headless",
      "description": "Default mode."
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "default": 200000,
          "description": "Per input file (below the Read tool's 256 KB refusal)."
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "default": 1048576,
          "description": "Total of provided patches before files are skipped."
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "default": 300,
          "description": "Number of input files."
        },
        "hard_ceiling_bytes": {
          "type": "integer",
          "minimum": 1,
          "default": 8388608,
          "description": "The PR's whole diff above this fails the run (too_large)."
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1,
          "default": 8388608,
          "description": "Artifact size above this is artifact_invalid."
        }
      },
      "additionalProperties": false,
      "required": [],
      "default": {}
    },
    "retention": {
      "$ref": "#/$defs/duration",
      "default": "30d",
      "description": "Age at which prune deletes terminal runs."
    },
    "me": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._@-]{1,64}$",
          "default": null,
          "description": "Used only for the default actor; null: the OS username."
        }
      },
      "additionalProperties": false,
      "required": [],
      "default": {}
    },
    "hooks": {
      "type": "object",
      "properties": {
        "pre-run": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook_entry_pre"
          },
          "default": []
        },
        "post-run": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook_entry_post"
          },
          "default": []
        },
        "post-escalate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook_entry_post"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [],
      "default": {}
    },
    "repos": {
      "type": "object",
      "default": {},
      "description": "Per-repo overrides keyed by repo id. Precedence: flags, then repos.<id>, then environment, then global config, then defaults.",
      "patternProperties": {
        "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?::[0-9]{1,5})?(?:/(?!\\.\\.?(?:/|$))[A-Za-z0-9._-]+)+$": {
          "type": "object",
          "properties": {
            "skill": {
              "$ref": "#/$defs/skill",
              "description": "The skill; bundled default or any other."
            },
            "permission_profile": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^/",
              "description": "Permission profile file passed on every call; null: the bundled file."
            },
            "sandbox": {
              "enum": [
                "required",
                "preferred",
                "off"
              ],
              "description": "Session sandbox level passed on every call."
            },
            "setting_sources": {
              "type": "array",
              "items": {
                "enum": [
                  "user",
                  "project",
                  "local"
                ]
              },
              "uniqueItems": true,
              "description": "Setting sources passed on every call."
            },
            "env_allowlist": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "uniqueItems": true,
              "description": "Names passed with --env-allowlist-only."
            },
            "model": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "description": "--model; null: Claude Code's default."
            },
            "timeout": {
              "oneOf": [
                {
                  "$ref": "#/$defs/duration"
                },
                {
                  "type": "null"
                }
              ],
              "description": "--timeout; null: the kind's default (120 minutes)."
            },
            "subagents": {
              "type": "boolean",
              "description": "true drops the Agent and Task denies from the profile."
            },
            "max_subagent_depth": {
              "type": "integer",
              "minimum": 1,
              "description": "Depth variable when subagents is on."
            },
            "nits": {
              "type": "boolean",
              "description": "Ask the skill for nit-severity findings."
            },
            "guidelines_file": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "description": "A user-owned file placed in the prompt as trusted instructions."
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_file_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Per input file (below the Read tool's 256 KB refusal)."
                },
                "max_total_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Total of provided patches before files are skipped."
                },
                "max_files": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Number of input files."
                },
                "hard_ceiling_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The PR's whole diff above this fails the run (too_large)."
                },
                "max_artifact_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Artifact size above this is artifact_invalid."
                }
              },
              "additionalProperties": false,
              "required": []
            },
            "run_pr_code": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "description": "An argv list, never a shell string, run in the throwaway."
                },
                "sandbox": {
                  "enum": [
                    "required",
                    "preferred",
                    "off"
                  ],
                  "default": "required"
                },
                "timeout": {
                  "$ref": "#/$defs/duration",
                  "default": "300s",
                  "description": "Wall-clock limit; greater than 0."
                },
                "max_output_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1048576
                },
                "env_allow": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "uniqueItems": true,
                  "default": [],
                  "description": "Extra names for the command's environment (non-secret)."
                },
                "ro_binds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "uniqueItems": true,
                  "default": [],
                  "description": "Extra absolute paths bound read-only (language runtimes, pre-populated caches, a node_modules directory)."
                }
              },
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "description": "Only under repos.<id>.run_pr_code; a repo without it runs no command. There is no network key in v1."
            }
          },
          "additionalProperties": false,
          "required": []
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [],
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^(?:0|[0-9]+(?:ms|s|m|h|d))$",
      "description": "0, or an integer and a unit: ms, s, m, h, d."
    },
    "hook_entry_post": {
      "type": "object",
      "properties": {
        "cmd": {
          "type": "string",
          "minLength": 1,
          "description": "Run through sh -c in its own process group."
        },
        "timeout": {
          "$ref": "#/$defs/duration",
          "default": "30s"
        },
        "async": {
          "type": "boolean",
          "default": false,
          "description": "Run detached under a watchdog that enforces the timeout."
        }
      },
      "additionalProperties": false,
      "required": [
        "cmd"
      ],
      "description": "Cannot undo; failures are logged and warned, never fatal."
    },
    "hook_entry_pre": {
      "type": "object",
      "properties": {
        "cmd": {
          "type": "string",
          "minLength": 1,
          "description": "Run through sh -c in its own process group."
        },
        "timeout": {
          "$ref": "#/$defs/duration",
          "default": "30s"
        }
      },
      "additionalProperties": false,
      "required": [
        "cmd"
      ],
      "description": "Exit 0 continues; 13 escalates; any other non-zero exit or a timeout vetoes (exit 11)."
    },
    "mode": {
      "enum": [
        "headless",
        "interactive"
      ]
    },
    "skill": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "description": "A name Claude Code accepts as a slash command (plugin:skill or a bare name)."
    }
  }
}
