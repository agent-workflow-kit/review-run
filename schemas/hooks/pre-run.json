{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-run/hooks/pre-run.json",
  "title": "pre-run hook payload (stdin)",
  "description": "After resolve, before the run record exists and before any read of the diff or launch. Exit 0 continues, 13 escalates, any other non-zero vetoes (exit 11). Only trusted or derived values: never PR text.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "review-run"
    },
    "hook": {
      "const": "pre-run"
    },
    "object_type": {
      "const": "run"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/run_id",
      "description": "The reserved run id; no run record exists yet."
    },
    "repo": {
      "$ref": "../defs.json#/$defs/repo_id"
    },
    "labels": {
      "$ref": "../defs.json#/$defs/labels"
    },
    "pr": {
      "$ref": "../defs.json#/$defs/pr"
    },
    "skill": {
      "$ref": "../defs.json#/$defs/skill"
    },
    "mode": {
      "$ref": "../defs.json#/$defs/mode"
    },
    "previous_run": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/run_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "head_sha": {
      "$ref": "../defs.json#/$defs/sha"
    },
    "actor": {
      "$ref": "../defs.json#/$defs/actor"
    },
    "decision_ids": {
      "$ref": "../defs.json#/$defs/decision_ids"
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "hook",
    "object_type",
    "object_id",
    "repo",
    "labels",
    "pr",
    "skill",
    "mode",
    "previous_run",
    "head_sha",
    "actor",
    "decision_ids"
  ]
}
