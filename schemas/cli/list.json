{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-run/cli/list.json",
  "title": "review-run list --json",
  "description": "Newest first; does not refresh runs.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/run"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runs"
  ]
}
