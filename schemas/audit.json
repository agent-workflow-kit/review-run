{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-run/audit.json",
  "title": "review-run audit.jsonl record",
  "description": "One line of audit.jsonl (export prints these). run and resume write one record at the start (result.status attempted) and one at the end with the outcome; teardown and prune write one each. No record holds PR text, the artifact or meta text. Retention is forever; the records of pruned runs stay.",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "defs.json#/$defs/ts"
    },
    "actor": {
      "$ref": "defs.json#/$defs/actor"
    },
    "decision_id": {
      "$ref": "defs.json#/$defs/decision_ids",
      "description": "The caller's --decision-id values and those a pre-run hook printed; possibly empty."
    },
    "action": {
      "enum": [
        "run",
        "resume",
        "teardown",
        "prune"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "run_id": {
          "oneOf": [
            {
              "$ref": "defs.json#/$defs/run_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "pr": {
          "oneOf": [
            {
              "$ref": "defs.json#/$defs/pr"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "run_id",
        "pr"
      ],
      "description": "The run id and PR; both null for prune."
    },
    "inputs": {
      "type": "object"
    },
    "result": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "required": [
    "ts",
    "actor",
    "decision_id",
    "action",
    "target",
    "inputs",
    "result"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "run",
              "resume"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "type": "object",
            "properties": {
              "run_id": {
                "$ref": "defs.json#/$defs/run_id"
              },
              "pr": {
                "$ref": "defs.json#/$defs/pr"
              }
            },
            "additionalProperties": false,
            "required": [
              "run_id",
              "pr"
            ]
          },
          "inputs": {
            "type": "object",
            "properties": {
              "head_sha": {
                "oneOf": [
                  {
                    "$ref": "defs.json#/$defs/sha"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The anchor head sha; null in the attempted record, before the anchor is known."
              },
              "config_sha256": {
                "$ref": "defs.json#/$defs/sha256"
              },
              "skill": {
                "$ref": "defs.json#/$defs/skill"
              },
              "previous_run": {
                "oneOf": [
                  {
                    "$ref": "defs.json#/$defs/run_id"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "head_sha",
              "config_sha256",
              "skill",
              "previous_run"
            ]
          },
          "result": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "attempted",
                  "done",
                  "failed",
                  "escalated"
                ]
              },
              "reason": {
                "enum": [
                  "prefetch_failed",
                  "stale_head",
                  "too_large",
                  "launch_failed",
                  "canceled",
                  "session_failed",
                  "unreported",
                  "killed",
                  "timeout",
                  "lost",
                  "implicit_done",
                  "artifact_missing",
                  "artifact_mismatch",
                  "skill_missing",
                  "artifact_invalid",
                  "internal",
                  "needs_input",
                  "blocked",
                  null
                ]
              },
              "exit_code": {
                "oneOf": [
                  {
                    "$ref": "defs.json#/$defs/run_exit_code"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "status",
              "reason",
              "exit_code"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "teardown"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "type": "object",
            "properties": {
              "run_id": {
                "$ref": "defs.json#/$defs/run_id"
              },
              "pr": {
                "$ref": "defs.json#/$defs/pr"
              }
            },
            "additionalProperties": false,
            "required": [
              "run_id",
              "pr"
            ]
          },
          "inputs": {
            "type": "object",
            "properties": {
              "agent_id": {
                "$ref": "defs.json#/$defs/agent_id"
              }
            },
            "additionalProperties": false,
            "required": [
              "agent_id"
            ]
          },
          "result": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "done",
                  "failed"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "status"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "prune"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "older_than": {
                "$ref": "defs.json#/$defs/duration"
              }
            },
            "additionalProperties": false,
            "required": [
              "older_than"
            ]
          },
          "result": {
            "type": "object",
            "properties": {
              "status": {
                "const": "done"
              },
              "deleted_runs": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "required": [
              "status",
              "deleted_runs"
            ]
          }
        }
      }
    }
  ]
}
